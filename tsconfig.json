// Ratline control plane — strict per brief §6.7.
//
// There is no build step FOR THE CONTROL PLANE. Node runs the TypeScript
// directly via type stripping, so tsc is a checker only (noEmit), and
// `erasableSyntaxOnly` keeps the codebase inside the subset Node can strip: no
// enums, no namespaces, no parameter properties, no decorators with emit.
//
// The browser bundle is the one exception, and it is a real one. ADR 0001 chose
// no-build-step partly on SvelteKit's behalf; the 2026-08-02 ruling chose React,
// and JSX is not erasable — `node --experimental-strip-types` refuses a .tsx
// file outright, as does --experimental-transform-types. Vite therefore compiles
// src/web/app/** and nothing else.
//
// The consequence is drawn deliberately rather than absorbed: anything that can
// be TESTED must be reachable without that build step, so the shell's structure
// lives in .ts as data and the .tsx files only render it. `jsx: react-jsx` below
// applies to the .tsx files; every other file in the project still runs unbuilt.
{
  "compilerOptions": {
    "target": "es2023",
    // DOM for the browser bundle only. Nothing under src/api, src/repo, src/auth
    // or src/db may reference it; `test/toolchain/scaffold.test.ts` is where a
    // rule about that would go if one is ever needed.
    "lib": ["es2023", "dom", "dom.iterable"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],
    "jsx": "react-jsx",

    // Required by RL-M1-001. `strict` alone is not enough: the two flags the
    // acceptance names catch the mistakes that actually cause runtime faults —
    // unchecked index access, and optional properties that can hold undefined.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,

    // No-build-step constraints.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "vite.config.ts",
    // The task board (RL-M1-061). Included rather than excluded: it is real TypeScript
    // with React, and a dev tool that is not typechecked is a dev tool that breaks
    // quietly. docs-site/ is excluded from LINT because it is hand-written vanilla JS
    // with no types at all; this is the opposite case.
    "tools/board/**/*.ts",
    "tools/board/**/*.tsx",
    "tools/board/vite.config.ts"
  ],
  "exclude": [
    "node_modules",
    // Scratch git worktrees for delegated agents. Each is a COMPLETE checkout, so without
    // this line `tsc --noEmit` typechecks one copy of the codebase per worktree — five
    // copies with four agents present, which is how `npm run typecheck` went from seconds
    // to minutes and starved two parallel agents past their 600s watchdog.
    //
    // Worse than slow: it reports errors from another branch's work in progress as though
    // they were in this tree, so a clean checkout looks broken because somebody else is
    // mid-edit. eslint has ignored `.claude/**` for this exact reason since RL-M1-001;
    // tsconfig never got the same line.
    ".claude/**",
    // Vite's bundled output. Not source, not in the program, and it appears the moment
    // anybody runs a build before a typecheck.
    "dist/**"
  ]
}
