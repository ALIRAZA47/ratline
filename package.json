{
  "name": "ratline",
  "version": "0.0.0",
  "private": true,
  "description": "Self-hosted deployment and server management platform — control plane",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning 'test/**/*.test.ts'",
    "test:coverage": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-exclude=scripts/** 'test/**/*.test.ts'",
    "tasks": "./scripts/tasks",
    "check": "npm run lint && npm run typecheck && npm test && ./scripts/tasks validate",
    "dev": "vite",
    "build:web": "vite build"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "@hono/node-server": "^2.0.12",
    "@peculiar/x509": "^2.0.0",
    "hono": "^4.13.0",
    "pg": "^8.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  }
}
